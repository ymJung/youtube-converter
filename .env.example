# TubeShift (YouTube to MP3/MP4 Converter) Configuration
HOST=0.0.0.0
PORT=8010

# Docker MySQL Configuration (Loaded from ~/.env by default)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=youtube_converter

# Telegram Notifications & Bot Poller (Loaded from ~/.env by default)
TELEGRAM_USER_ID=
TELEGRAM_BOT_3=
